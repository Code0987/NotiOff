<?xml version="1.0" encoding="utf-8"?>
<!-- Only DataStore is included. Legacy default.realm under files/ is not included (K20). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
